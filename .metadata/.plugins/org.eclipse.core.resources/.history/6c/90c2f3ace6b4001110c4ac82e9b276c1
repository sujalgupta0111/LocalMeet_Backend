package com.users.entity;

public enum RegistrationSource {
	LOCAL, OUTH_GOOGLE, OUTH_DISCORD, OUTH_GITHUB, OUTH_FACEBOOK, OUTH_TWITTER;

	private RegistrationSource getRegistrationSource(String provider) {

		return switch (provider.toLowerCase()) {

		case "google" -> RegistrationSource.OUTH_GOOGLE;

		case "discord" -> RegistrationSource.OUTH_DISCORD;

		case "github" -> RegistrationSource.OUTH_GITHUB;

		case "facebook" -> RegistrationSource.OUTH_FACEBOOK;

		case "twitter" -> RegistrationSource.OUTH_TWITTER;

		default -> throw new IllegalArgumentException("Unsupported OAuth provider: " + provider);
		};
	}
}