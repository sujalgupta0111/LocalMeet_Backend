app:
  name: userservice

spring:
  application:
    # Application ka naam
    # Logs, Actuator aur Service Discovery me dikhai deta hai
    name: userservice

  datasource:
    # MySQL database connection URL
    # Database name: user
    url: jdbc:mysql://localhost:3306/user?useSSL=false&allowPublicKeyRetrieval=true

    # Database username
    username: root

    # Database password
    password: Chirag@0111

    # MySQL JDBC Driver
    driver-class-name: com.mysql.cj.jdbc.Driver

    # HikariCP Connection Pool Configuration
    hikari:
      # Maximum kitne database connections ek saath pool me rahenge
      maximum-pool-size: 20

      # Minimum idle connections jo hamesha available rahenge
      minimum-idle: 5

      # Connection kitni der idle rahe to remove kar diya jaye (milliseconds)
      idle-timeout: 30000

      # Naya connection milne ke liye maximum wait time (milliseconds)
      connection-timeout: 20000

  jpa:
    hibernate:
      # Schema generation strategy
      # create      -> Startup par tables create karega
      # create-drop -> Shutdown par tables delete karega
      # update      -> Existing tables ko update karega
      # validate    -> Sirf validate karega
      ddl-auto: update

    # Hibernate ki generated SQL queries console me show hongi
    show-sql: true

    properties:
      hibernate:
        # SQL ko formatted (readable) form me print karega
        format_sql: true
        use_sql_comments: true
        id:
          new_generator_mappings: true

  servlet:
    multipart:
      # Single file upload ki maximum size
      max-file-size: 100MB

      # Total request size (multiple files + form data)
      max-request-size: 100MB
