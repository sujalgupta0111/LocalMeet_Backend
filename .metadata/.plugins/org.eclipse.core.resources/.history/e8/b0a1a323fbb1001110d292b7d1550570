app:
  name: userservice

spring:
  application:
    # Application ka naam
    # Logs, Actuator aur Service Discovery me dikhai deta hai
    name: userservice

  datasource:
    # MySQL database connection URL
    # Database name: user
    url: jdbc:mysql://localhost:3306/user?useSSL=false&allowPublicKeyRetrieval=true

    # Database username
    username: root

    # Database password
    password: ${DB_PASSWORD}

    # MySQL JDBC Driver
    driver-class-name: com.mysql.cj.jdbc.Driver

    # HikariCP Connection Pool Configuration
    hikari:
      # Maximum database connections
      maximum-pool-size: 20

      # Minimum idle connections
      minimum-idle: 5

      # Idle connection timeout (milliseconds)
      idle-timeout: 30000

      # Maximum time to wait for a connection (milliseconds)
      connection-timeout: 20000

  jpa:
    hibernate:
      # Schema generation strategy
      # create      -> Startup par tables create karega
      # create-drop -> Shutdown par tables delete karega
      # update      -> Existing tables ko update karega
      # validate    -> Sirf validate karega
      ddl-auto: update

    # Hibernate generated SQL console me show hoga
    show-sql: true

    properties:
      hibernate:
        # SQL ko formatted/readable form me print karega
        format_sql: true
        use_sql_comments: true

        id:
          new_generator_mappings: true

  servlet:
    multipart:
      # Single file upload ki maximum size
      max-file-size: 100MB

      # Total request size
      max-request-size: 100MB

  security:
    oauth2:
      client:
        registration:
          google:
            client-id: 1066777697646-c7vt5g7vlh2d424rk217r8bvd2p4edc6.apps.googleusercontent.com
            client-secret: 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
            scope:
              - openid
              - profile
              - email

server:
  # Application kis port par chalegi
  port: 7070

  servlet:
    # Application ka base context path
    # Final URL:
    # http://localhost:7070/users
    context-path: /users

# Eureka configuration
# eureka:
#   client:
#     service-url:
#       defaultZone: http://localhost:8067/eureka/

logging:
  level:
    # Application ka default log level
    root: INFO

    # Spring MVC request logs
    org.springframework.web: DEBUG

    # Hibernate SQL logs
    org.hibernate.SQL: DEBUG

jwt:
  secret: mySuperSecretKeyForJWTAuthenticationSpringBootProject2026HS512SecureKey1234567890ABCDEF

  token:
    # Token validity: 1 hour
    validity: 3600000
