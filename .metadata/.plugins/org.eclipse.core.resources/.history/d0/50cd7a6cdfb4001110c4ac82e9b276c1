	                .name((String) attributes.get("global_name"))
	                .profileImageUrl((String) attributes.get("avatar"))
	                .emailVerified((Boolean) attributes.get("verified"))
	                .locale((String) attributes.get("locale"));
	        }

	        case "github" -> {
	            builder
	                .providerUserId(String.valueOf(attributes.get("id")))
	                .username((String) attributes.get("login"))
	                .email((String) attributes.get("email"))
	                .name((String) attributes.get("name"))
	                .profileImageUrl((String) attributes.get("avatar_url"))
	                .profileUrl((String) attributes.get("html_url"));
	        }

	        case "facebook" -> {
	            builder
	                .providerUserId((String) attributes.get("id"))
	                .name((String) attributes.get("name"))
	                .email((String) attributes.get("email"));
	        }

	        case "linkedin" -> {
	            builder
	                .providerUserId((String) attributes.get("sub"))
