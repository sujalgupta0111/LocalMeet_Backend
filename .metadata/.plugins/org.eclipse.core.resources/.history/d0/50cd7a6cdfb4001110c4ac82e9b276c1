package com.users.outh;

import jakarta.servlet.ServletException;

import jakarta.servlet.http.HttpServletRequest;
import jakarta.servlet.http.HttpServletResponse;
import lombok.RequiredArgsConstructor;

import org.springframework.security.core.Authentication;
import org.springframework.security.oauth2.client.authentication.OAuth2AuthenticationToken;
import org.springframework.security.oauth2.core.user.OAuth2User;
import org.springframework.security.web.authentication.AuthenticationSuccessHandler;
import org.springframework.stereotype.Component;

import com.users.jwt.JwtToken;
import com.users.jwt.UserDetailsImpl;

import java.io.IOException;
import java.net.URLEncoder;
import java.nio.charset.StandardCharsets;
import java.util.Map;

@RequiredArgsConstructor
@Component
public class OAuth2AuthenticationSuccessHandler implements AuthenticationSuccessHandler {

	public static int Counter = 0;
	private final JwtToken jwtTokenUtil;

	@Override
	public void onAuthenticationSuccess(HttpServletRequest request, HttpServletResponse response,
			Authentication authentication) throws IOException, ServletException {
		OAuth2AuthenticationToken oauthToken = (OAuth2AuthenticationToken) authentication;
		OAuth2User oauth2User = oauthToken.getPrincipal();

		UserDetailsImpl userDetails = (UserDetailsImpl) oauth2User;
		System.out.println("UserDetailsImpl: " + userDetails.getUsername());

		String token = jwtTokenUtil.generateToken(userDetails);
		Map<String, Object> attributes = oauth2User.getAttributes();
		String provider = oauthToken.getAuthorizedClientRegistrationId();

		response.sendRedirect(
				"http://localhost:3000/oauth/callback?token=" + URLEncoder.encode(token, StandardCharsets.UTF_8));
	}

	private OAuth2UserDetailsDTO saveOAuthUser(
	        String provider,
	        Map<String, Object> attributes) {

	    OAuth2UserDetailsDTO.OAuth2UserDetailsDTOBuilder builder =
	            OAuth2UserDetailsDTO.builder()
	                    .provider(provider);

	    switch (provider.toLowerCase()) {

	        case "google" -> {
	            builder
	                .providerUserId((String) attributes.get("sub"))
	                .username((String) attributes.get("email"))
	                .email((String) attributes.get("email"))
	                .name((String) attributes.get("name"))
	                .firstName((String) attributes.get("given_name"))
	                .lastName((String) attributes.get("family_name"))
	                .profileImageUrl((String) attributes.get("picture"))
	                .emailVerified((Boolean) attributes.get("email_verified"))
	                .locale((String) attributes.get("locale"));
